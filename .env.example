# Frontend environment variables
# Copy this file to .env and fill in your values

# Backend API URL
VITE_API_BASE_URL=https://eliza-ai-voice-agent-bd.onrender.com

# Firebase Authentication (Add your Firebase web app config from Firebase Console)
# Firebase API keys are PUBLIC client-side identifiers by design — they are not secrets.
# The actual security comes from backend ID token verification via Firebase Admin SDK.
# Get your config from: Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id:web:your_app_id

# Firebase App Check (reCAPTCHA Enterprise) — bot protection
# Get token from: Firebase Console > Project Settings > App Check
VITE_FIREBASE_APPCHECK_TOKEN=your_appcheck_token